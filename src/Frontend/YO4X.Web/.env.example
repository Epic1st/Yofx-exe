# Same-origin is the secure default. Set only when the ControlPlane API is on a separate origin.
VITE_YO4X_CONTROL_API_ORIGIN=

# Optional current dashboard context. Missing IDs produce explicit empty states.
VITE_YO4X_BROKER_ACCOUNT_ID=
VITE_YO4X_DEPLOYMENT_ID=

# Optional tenant-owned strategy corpus and ControlPlane read projection.
# Compatibility is fetched only from /v1/strategy-source-corpora/{corpusId}/compatibility.
VITE_YO4X_STRATEGY_CORPUS_ID=
VITE_YO4X_RUNTIME_READINESS_PATH=

# Optional identity-provider entry point used by the unauthorized state.
VITE_YO4X_SIGN_IN_URL=/auth/sign-in

# Development only: enables the fixed https://127.0.0.1:7210 OIDC provider for
# client yo4x-web-development and callback http://127.0.0.1:4173/auth/callback.
VITE_YO4X_DEVELOPMENT_IDENTITY_ENABLED=false
