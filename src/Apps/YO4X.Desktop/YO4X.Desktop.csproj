<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>YO4X</AssemblyName>
    <RootNamespace>YO4X.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <Target Name="RemovePublishedWebViewDocumentation" AfterTargets="Publish">
    <ItemGroup>
      <PublishedWebViewDocumentation Include="$(PublishDir)Microsoft.Web.WebView2.Core.xml" />
      <PublishedWebViewDocumentation Include="$(PublishDir)Microsoft.Web.WebView2.WinForms.xml" />
      <PublishedWebViewDocumentation Include="$(PublishDir)Microsoft.Web.WebView2.Wpf.xml" />
    </ItemGroup>
    <Delete Files="@(PublishedWebViewDocumentation)" />
  </Target>

</Project>
