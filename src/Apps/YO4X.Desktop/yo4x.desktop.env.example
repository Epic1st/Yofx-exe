# Copy to yo4x.desktop.env beside YO4X.exe during deployment.
# Public endpoints only: never put database credentials, signing keys,
# marketplace secrets, or MT5 passwords in the desktop package.
YO4X_CONTROL_API_ORIGIN=https://api.example.com/
YO4X_DESKTOP_IDENTITY_URL=https://auth.example.com/

# Development loopback only; omit with a publicly trusted certificate.
# YO4X_DESKTOP_IDENTITY_CERTIFICATE_SHA256=64_HEXADECIMAL_CHARACTERS
