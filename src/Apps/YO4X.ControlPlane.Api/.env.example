# Copy to .env, or point YO4X_BACKEND_ENV_FILE at a protected file.
# Never commit the populated file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:7209

ConnectionStrings__Postgres=Host=db.example.com;Port=5432;Database=yo4x;Username=yo4x_control_api;Password=replace-me;SSL Mode=VerifyFull;Root Certificate=C:\\secure\\postgres-ca.crt
ConnectionStrings__ContextIssuer=Host=db.example.com;Port=5432;Database=yo4x;Username=yo4x_context_issuer;Password=replace-me;SSL Mode=VerifyFull;Root Certificate=C:\\secure\\postgres-ca.crt
ConnectionStrings__RuntimePostgres=Host=db.example.com;Port=5432;Database=yo4x;Username=yo4x_worker;Password=replace-me;SSL Mode=VerifyFull;Root Certificate=C:\\secure\\postgres-ca.crt
ConnectionStrings__RuntimeEvidencePostgres=Host=db.example.com;Port=5432;Database=yo4x;Username=yo4x_runtime_evidence;Password=replace-me;SSL Mode=VerifyFull;Root Certificate=C:\\secure\\postgres-ca.crt

Authentication__User__Authority=https://auth.example.com/
Authentication__User__Audience=yo4x-control-plane
Authentication__Workload__Authority=https://auth.example.com/
Authentication__Workload__Audience=yo4x-runtime

# The UI is embedded in the desktop app and served from its loopback-only shell.
Frontend__AllowedOrigins__0=http://127.0.0.1:4173
Frontend__AllowedOrigins__1=http://127.0.0.1:4174

MarketplacePublication__SharedSecretFile=C:\\secure\\marketplace-publication.secret
MarketplacePublication__PackageKeyDocumentFile=C:\\secure\\package-keys.json
MarketplacePublication__ArtifactRoot=C:\\yo4x-data\\strategy-packages
MarketplacePublication__TenantId=00000000-0000-0000-0000-000000000000
MarketplacePublication__ActorId=00000000-0000-0000-0000-000000000000
