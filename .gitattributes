* text=auto

*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
*.sql text eol=lf
*.mq5 -text
*.mqh -text
*.mq4 -text
*.ps1 text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.ts text eol=crlf
*.tsx text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf

# Deterministic MQL evidence is hashed byte-for-byte and always emitted as LF.
artifacts/verification/mql5/*.json text eol=lf
artifacts/verification/mql5/*.md text eol=lf
docs/backend/mq5-static-manifest.v1.json text eol=lf
docs/backend/MQ5_COMPATIBILITY_REPORT.md text eol=lf
docs/backend/mql5-quarantine-intake.v2.json text eol=lf
docs/backend/MQL5_NONCANONICAL_INTAKE_REPORT.md text eol=lf

*.dll filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
